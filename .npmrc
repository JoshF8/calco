# Security hygiene per docs/ARCHITECTURE.md §Security.

# Refuse to install npm packages published less than 24 hours ago,
# giving the community time to detect supply-chain attacks.
# (Context: TanStack npm incident, 11 May 2026.)
minimum-release-age=86400000

# Always pin exact versions when adding new packages.
# No ^ or ~ prefixes in package.json.
save-exact=true
